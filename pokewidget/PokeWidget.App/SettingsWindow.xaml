<Window x:Class="PokeWidget.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="Réglages du widget Pokémon" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="#1E2327" Foreground="#F2F4F5" FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Seed" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="SeedBox" Style="{StaticResource PkTextBox}" MaxLength="100"/>
            <TextBlock Text="Les personnes qui utilisent la même seed voient le même Pokémon au même moment."
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18"/>

            <TextBlock Text="Position du widget" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <UniformGrid x:Name="PosGrid" Columns="2" Width="300" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <TextBlock Text="Affichage" FontWeight="SemiBold" Margin="0,8,0,6"/>
            <UniformGrid x:Name="ModeGrid" Columns="1" Width="300" HorizontalAlignment="Left"/>
            <TextBlock Text="Sur le bureau : le widget reste sous tes fenêtres. Win+D le réduit, il revient dès qu'une fenêtre s'ouvre. Toujours au-dessus : visible par-dessus tout."
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,16"/>

            <CheckBox x:Name="StartupCheck" Content="Lancer le widget au démarrage de Windows" Margin="0,0,0,20"/>

            <TextBlock Text="Mises à jour" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckBtn" Content="Vérifier maintenant" Style="{StaticResource PkButton}" Click="CheckNow_Click" Margin="0,0,8,0"/>
                <Button x:Name="DownloadBtn" Visibility="Collapsed" Style="{StaticResource PkPrimaryButton}" Click="Download_Click"/>
            </StackPanel>
            <TextBlock x:Name="UpdateMsg" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8"/>
            <CheckBox x:Name="AutoCheck" Content="Vérifier automatiquement (une fois par jour)" Margin="0,0,0,20"/>

            <TextBlock Text="Sauvegarde de la progression" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Exporter (.pokesave)" Style="{StaticResource PkButton}" Click="Export_Click" Margin="0,0,8,0"/>
                <Button Content="Importer…" Style="{StaticResource PkButton}" Click="Import_Click"/>
            </StackPanel>
            <TextBlock x:Name="BackupMsg" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"
                       Text="Le fichier .pokesave contient tes balls, ton Pokédex et tes réglages (seed, position)."/>

            <TextBlock Text="Communauté" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Button Content="💬 Rejoindre le Discord" Style="{StaticResource PkButton}" Click="Discord_Click" HorizontalAlignment="Left" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource PkButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Enregistrer" Style="{StaticResource PkPrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
